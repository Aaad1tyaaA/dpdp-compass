# Copy to backend/.env (backend reads backend/.env → project/.env → cwd/.env). Never commit real keys.

# === LLM — OpenRouter mandatory gateway (keep-all-as-is: LLM_API_KEY still read as fallback) ===
MOCK_LLM=false
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_FALLBACK_MODELS=openrouter/free,google/gemini-2.0-flash:free
# Research (Mode A, reproducible): pin LLM_MODEL above. Dev (Mode B): LLM_MODEL=openrouter/free
# Compat: OPENAI_API_KEY still works as fallback. Never print keys; /health shows only prefix.

# === Embeddings (pretrained, configurable; same for docs+queries) ===
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# === Knowledge Base (Qdrant primary, Chroma alt, Neo4j, Postgres) ===
VECTOR_STORE=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=dpdp_chunks
CHROMA_URL=http://localhost:8001
CHROMA_COLLECTION=dpdp_chunks
POSTGRES_URL=postgresql://dpdp:dpdp@localhost:5432/dpdp
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# === Retrieval ===
TOP_K=8
HYBRID_ALPHA=0.7
MAX_FEEDBACK_ITERATIONS=3
