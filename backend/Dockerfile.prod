# Production image for the DPDP Compass API.
# Models are downloaded at build time, so the container makes no outbound calls except to the LLM provider.
FROM python:3.13-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 HF_HOME=/opt/hf
WORKDIR /app

COPY requirements.lock ./
RUN pip install --retries 10 --timeout 120 -r requirements.lock

RUN python -c "from sentence_transformers import SentenceTransformer, CrossEncoder; \
SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2'); CrossEncoder('cross-encoder/ms-marco-MiniLM-L-6-v2')"

COPY app ./app
COPY eval ./eval
# The Act's Gazette PDF is expected at /data/legal (see docker-compose.prod.yml).

RUN useradd --system --uid 10001 --home /app compass \
 && mkdir -p /app/storage /app/.cache && chown -R compass /app/storage /app/.cache /opt/hf
USER compass

ENV ENV=production HF_HUB_OFFLINE=1 PORT=8000
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD python -c "import urllib.request,os,sys; sys.exit(0 if urllib.request.urlopen(f'http://127.0.0.1:{os.environ[\"PORT\"]}/ready', timeout=4).status == 200 else 1)"

# One worker: the rate limiter and the SQLite audit store are per-process (see docs/OPERATIONS.md).
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --workers 1 --proxy-headers --forwarded-allow-ips='*' --timeout-keep-alive 30"]
