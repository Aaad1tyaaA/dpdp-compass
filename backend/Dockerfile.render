# Render image for the DPDP Compass API. Built from the repository root so the Gazette PDFs (data/legal) and
# reference policies are baked in. The retrieval models run on ONNX (no PyTorch, int8, lean sessions)
# so it fits a 512 MB instance; measured peak about 400 MB.
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    MODEL_RUNTIME=onnx MODEL_THREADS=1 FASTEMBED_CACHE_PATH=/opt/models MALLOC_ARENA_MAX=2
WORKDIR /app

COPY backend/requirements.render.txt ./
RUN pip install --retries 10 --timeout 120 -r requirements.render.txt

COPY backend/app ./app
# download the int8 ONNX models at build time (app/compass/models.py), so start-up makes no model downloads
RUN python -c "from app.compass.models import load_embedder, load_reranker; \
load_embedder('sentence-transformers/all-MiniLM-L6-v2'); load_reranker('cross-encoder/ms-marco-MiniLM-L-6-v2')"
COPY backend/eval ./eval
COPY data/legal /data/legal
COPY data/company_policies ./data/company_policies

RUN useradd --system --uid 10001 --home /app compass \
 && mkdir -p /app/storage /app/.cache && chown -R compass /app/storage /app/.cache /opt/models
USER compass

ENV ENV=production HF_HUB_OFFLINE=1 PORT=8000
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT} --workers 1 --proxy-headers --forwarded-allow-ips='*' --timeout-keep-alive 30"]
