# Copy to .env.production. Never commit the filled-in file.

# Public URL of the web app (used for the CORS allowlist)
PUBLIC_ORIGIN=https://compass.example.org
WEB_PORT=8080

# Language model: any OpenAI-compatible endpoint
MOCK_LLM=false
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=
# Optional, comma-separated: used when the main key is rate-limited or rejected
LLM_FALLBACK_API_KEYS=

# API protection
AUTH_REQUIRED=true            # every /api call needs a signed-in user (or the service API_KEY)
API_KEY=                      # if set, every POST /api/* must send X-API-Key
RATE_LIMIT_PER_MIN=30         # per client IP
MAX_BODY_BYTES=12000000
TRUSTED_HOSTS=compass.example.org,backend

# Stores. Embedded stores are used when these servers are not reachable.
QDRANT_URL=http://qdrant:6333
NEO4J_URI=bolt://neo4j:7687
